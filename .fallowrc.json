{
  // This file is JSONC: fallow reads these comments; generic JSON tools may not.
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}"
  ],
  "workspaces": {
    "patterns": [
      "frontend",
      "shared"
    ]
  },
  // Importadas pelos contratos .sol (e pelo hardhat.config.ts no caso do poseidon); o fallow não lê Solidity.
  "ignoreDependencies": [
    "@openzeppelin/contracts",
    "@semaphore-protocol/contracts",
    "forge-std",
    "poseidon-solidity"
  ],
  // Componentes gerados pelo shadcn: exportam todas as partes, mesmo as que o app ainda não usa.
  "ignoreExports": [
    { "file": "frontend/src/components/ui/**", "exports": ["*"] }
  ],
  "duplicates": {
    // Hide pair-only clones; focus on widespread copy-paste
    // worth refactoring. Lower to 2 to report every duplicate pair.
    "minOccurrences": 3,
    // Gerado por `pnpm export-abis`: as ABIs repetem os mesmos structs e erros.
    "ignore": ["frontend/src/contracts/abis.ts"]
  },
  // Achados aceitos em 2026-11-09 (APIs index.ts, funções complexas): o gate do commit só barra os novos.
  // Depois de corrigir um, rode `fallow baselines prune` para tirá-lo da linha de base.
  "audit": {
    "gate": "new-only",
    "deadCodeBaseline": "fallow-baselines/dead-code.json",
    "healthBaseline": "fallow-baselines/health.json",
    "dupesBaseline": "fallow-baselines/dupes.json"
  },
  "rules": {
    "unused-dependencies": "warn",
    // Sem zonas de arquitetura nem rule packs definidos: os detectores ficam desligados de propósito.
    "boundary-violation": "off",
    "policy-violation": "off"
  }
}
