{
  "name": "ethereum_elections_dapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "frontend:dev": "pnpm --filter @elections/frontend dev",
    "frontend:build": "pnpm --filter @elections/frontend build",
    "frontend:test": "pnpm --filter @elections/frontend test",
    "frontend:dev:e2e": "pnpm --filter @elections/frontend dev:e2e",
    "scripts:test": "node --test scripts/select-packages.test.mjs",
    "shared:test": "pnpm --filter @elections/shared test",
    "contracts:compile": "pnpm --filter @elections/contracts compile",
    "contracts:test": "pnpm --filter @elections/contracts test",
    "contracts:node:local": "pnpm --filter @elections/contracts node:local",
    "contracts:deploy:local": "pnpm --filter @elections/contracts deploy:local",
    "contracts:export-abis": "pnpm --filter @elections/contracts export-abis",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7"
  }
}
