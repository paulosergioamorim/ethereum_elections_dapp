{
  "compilerOptions": {
    "lib": ["es2023"],
    "module": "node20",
    "target": "es2023",
    "skipLibCheck": true,
    "outDir": "dist",
    // os testes importam ../shared (por caminho relativo), que fica fora deste pacote
    "rootDir": "..",
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "exclude": ["node_modules", "dist"]
}
