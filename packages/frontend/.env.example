# Copie para .env.local e ajuste. Tudo que começa com VITE_ vai para o bundle: é público.
# Os valores são validados ao abrir o app (src/lib/env.ts).

# Rede do app: 11155111 (Sepolia) ou 31337 (nó local do Hardhat)
VITE_CHAIN_ID=11155111

# RPC por HTTP, usado nas leituras. Vazio: RPC público padrão do viem para a rede (limitado demais).
# Gateway público da Tenderly: sem chave e com `eth_getLogs` confiável (testado em 2026-11-11).
# O PublicNode falha no `eth_getLogs` ao acaso ("pruned history unavailable") e deixa o app sem
# conseguir montar a lista de eleitores.
# Com chave própria (ex.: Infura): https://sepolia.infura.io/v3/<chave>
# A chave fica visível no site: restrinja-a ao domínio no painel do provedor.
VITE_RPC_HTTP_URL=https://sepolia.gateway.tenderly.co

# RPC por WebSocket, usado primeiro quando existe (eventos ao vivo por eth_subscribe, sem polling).
# Vazio: só HTTP. Com chave própria (ex.: Infura): wss://sepolia.infura.io/ws/v3/<chave>
VITE_RPC_WS_URL=wss://sepolia.gateway.tenderly.co

# ElectionFactory implantada na Sepolia (ignition/deployments/chain-11155111/deployed_addresses.json)
VITE_FACTORY_ADDRESS=0xd3116C4f166f8CDA5f90fAEEB03FE8E8D7eD139C

# Bloco em que a factory foi implantada: as buscas de eventos começam nele, não no bloco 0.
VITE_FACTORY_DEPLOY_BLOCK=12093709
