{
  "compilerOptions": {
    "lib": ["es2023"],
    "module": "node20",
    "target": "es2023",
    "skipLibCheck": true,
    "outDir": "dist",
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  // o frontend tem o próprio tsconfig (DOM, JSX, bundler)
  "exclude": ["frontend", "node_modules", "dist"]
}
